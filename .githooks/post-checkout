#!/bin/bash

set -e

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -z "$ROOT_DIR" ]]; then
  exit 0
fi

if [[ -n "$SKIP_RELEASE_BUMP" ]]; then
  exit 0
fi

prev_ref="$1"
new_ref="$2"
flag="$3"

if [[ "$flag" != "1" ]]; then
  exit 0
fi

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [[ "$branch" == "HEAD" ]]; then
  exit 0
fi

if git show-ref --verify --quiet refs/heads/dev; then
  created_from_dev=$(git reflog show --no-abbrev --pretty=%gs "$branch" | head -n 1 | grep -c "Created from dev" || true)
  if [[ "$created_from_dev" -gt 0 ]]; then
    "$ROOT_DIR/scripts/release-manager.sh" --bump patch
  fi
fi
