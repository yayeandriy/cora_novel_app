{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cora",
  "version": "0.4.7",
  "identifier": "com.pluton.cora",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/cora/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Cora",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/file.icns"
    ],
    "fileAssociations": [
      {
        "ext": [
          "cora"
        ],
        "name": "Cora Project",
        "description": "Cora Novel Project File",
        "role": "Editor",
        "mimeType": "application/x-cora-project"
      }
    ],
    "macOS": {
      "bundleVersion": "122",
      "minimumSystemVersion": "11.0"
    }
  }
}
