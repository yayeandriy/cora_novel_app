<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- REQUIRED: App Sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    
    <!-- REQUIRED: App Identifier -->
    <key>com.apple.application-identifier</key>
    <string>2JL868AT85.com.pluton.cora</string>
    
    <!-- REQUIRED: Team Identifier -->
    <key>com.apple.developer.team-identifier</key>
    <string>2JL868AT85</string>
    
    <!-- File Access - User Selected Files (Read/Write) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Network Access (if your app needs internet) -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Printing (if your app has print functionality) -->
    <key>com.apple.security.print</key>
    <true/>

    <!-- iCloud Drive (CloudDocuments) -->
    <!-- NOTE: Enable iCloud capability for com.pluton.cora in the Apple Developer portal first,
         creating the container iCloud.com.pluton.cora, before building with these entitlements. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.pluton.cora</string>
    </array>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>iCloud.com.pluton.cora</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
    </array>
</dict>
</plist>
